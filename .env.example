# ---------------------------------------------------------------------------
# Forecast Model Sentinel — configuration
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# Which DataHub deployment to talk to: "selfhosted" | "cloud"
DATAHUB_MODE=selfhosted

# --- Self-hosted DataHub (datahub docker quickstart) ------------------------
# GMS is the metadata service. Quickstart exposes it on 8080; UI is on 9002.
DATAHUB_GMS_URL=http://localhost:8080
# Generate under Settings -> Access Tokens in the DataHub UI (login datahub/datahub).
# Quickstart with default config accepts an empty token.
DATAHUB_GMS_TOKEN=

# --- DataHub Cloud ---------------------------------------------------------
# Your tenant base URL, e.g. https://acme.acryl.io  (no trailing slash)
DATAHUB_TENANT_URL=
# Personal Access Token from the Cloud UI.
DATAHUB_TOKEN=

# --- MCP server behaviour --------------------------------------------------
# The sentinel writes findings back to the catalog (tags, descriptions, docs).
# The DataHub MCP server gates writes behind this flag.
TOOLS_IS_MUTATION_ENABLED=true
# Cap on tool-response size handed to the model.
TOOL_RESPONSE_TOKEN_LIMIT=80000

# --- Model judgement -------------------------------------------------------
# auto and openai prefer OpenAI, then retry with Anthropic if necessary.
# anthropic skips OpenAI and uses only the fallback provider.
SENTINEL_PROVIDER=auto
OPENAI_API_KEY=
SENTINEL_OPENAI_MODEL=gpt-5.6

# Anthropic fallback. Set one of these, or use an SDK-resolvable profile.
ANTHROPIC_API_KEY=
ANTHROPIC_AUTH_TOKEN=
SENTINEL_ANTHROPIC_MODEL=claude-opus-5
# low | medium | high | xhigh | max
SENTINEL_EFFORT=high

# --- Sentinel behaviour ----------------------------------------------------
# Refuse to run the model's downstream pipeline when a BLOCK verdict is issued.
SENTINEL_FAIL_ON_BLOCK=true
# Where snapshots, reports and run logs land.
SENTINEL_STATE_DIR=.sentinel
